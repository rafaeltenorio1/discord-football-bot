# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Chave da API-Football (api-football.com > Dashboard)
API_FOOTBALL_KEY=
# Opcional Ex: America/São Paulo
TIMEZONE=
# Plano grátis da API-Football: no máximo 1 (hoje + amanhã)
DAYS_AHEAD=1
DB_PATH=data/bot.db
# ID do seu servidor: faz os comandos / aparecerem na hora (opcional)
DEV_GUILD_ID=

# football-data.org (opcional, grátis): traz a rodada completa de Brasileirão, Premier League,
# La Liga, Champions e Copa do Mundo. Cadastre-se em football-data.org e copie o token.
FOOTBALL_DATA_TOKEN=
FD_DAYS_AHEAD=7
# Placar ao vivo (API-Football). Intervalo mínimo entre consultas, em minutos (aumenta sozinho se a cota baixar)
LIVE_INTERVAL_MINUTES=3
# Competições com placar ao vivo (IDs separados por vírgula). Vazio = todas. Ex.: 71,13
LIVE_LEAGUES=

# 1 = busca quem fez cada gol (gasta 1 requisição por gol, só com 30+ restantes). 0 = só placar
LIVE_SCORERS=0

# Minutos até apagar cada alerta de gol do canal (0 = manter)
ALERT_DELETE_MINUTES=30